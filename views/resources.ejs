<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,700&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="/css/style.css">
	<title>Resources &mdash; Cal State LA PRSSA</title>
</head>
<body class="bg-cream font-sans text-body">
	<%- include('partials/navbar') %>

	<!-- Intro -->
	<section class="flex flex-col gap-4.5 bg-cream-alt px-8 pb-14 pt-16 sm:px-14 sm:pt-18">
		<span class="text-xs tracking-[0.24em] uppercase text-brown">Resources</span>
		<h1 class="font-serif text-5xl leading-[1.04] text-ink sm:text-6xl">Tools we actually use</h1>
		<p class="max-w-2xl text-[17px] leading-relaxed text-body">Templates, job boards, and reading the board keeps coming back to. Member-only items are marked.</p>
	</section>

	<!-- Groups -->
	<section class="flex flex-col gap-10 px-8 pt-14 sm:px-14 sm:pt-18">
		<% resourceGroups.forEach(function(g) { %>
		<div class="grid grid-cols-1 gap-9 border-b border-border pb-10 sm:grid-cols-[300px_1fr]">
			<div class="flex flex-col gap-2.5">
				<h2 class="font-serif text-[32px] leading-[1.12] text-ink"><%= g.title %></h2>
				<p class="text-[15px] leading-relaxed text-muted"><%= g.note %></p>
			</div>
			<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
				<% g.items.forEach(function(r) { %>
				<a href="#" class="flex flex-col gap-2.5 border border-border bg-white p-6">
					<div class="flex flex-wrap items-center gap-2.5">
						<span class="font-serif text-xl text-ink"><%= r.name %></span>
						<span class="<%= r.badge === 'Members' ? 'bg-gold text-ink' : 'border border-border text-muted' %> px-2 py-0.5 text-[10px] tracking-[0.1em] uppercase"><%= r.badge %></span>
					</div>
					<p class="text-sm leading-relaxed text-muted"><%= r.desc %></p>
				</a>
				<% }); %>
			</div>
		</div>
		<% }); %>
	</section>

	<!-- CTA -->
	<div class="px-8 py-12 sm:px-14 sm:py-16">
		<div class="flex flex-wrap items-center justify-between gap-8 bg-ink px-9 py-11 text-gold sm:px-14">
			<div class="flex flex-col gap-2.5">
				<h2 class="font-serif text-[38px] leading-[1.1]">Members unlock the full library</h2>
				<p class="text-base text-[#C4BBA8]">Including the Internship Center, r&eacute;sum&eacute; bank, and chapter campaign archive.</p>
			</div>
			<a href="/join" class="whitespace-nowrap bg-gold px-7.5 py-4 text-xs tracking-[0.16em] uppercase text-ink">Become a member</a>
		</div>
	</div>

	<%- include('partials/footer') %>
</body>
</html>
